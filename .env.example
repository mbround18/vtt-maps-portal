MONGO_URI=mongodb://localhost:27018/vttmaps
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# Routed through the Vite dev proxy (which forwards /api -> :8080), not the
# API port directly, so the OAuth flow stays on one origin locally the same
# way an ingress would put it behind one hostname in a real deployment.
DISCORD_REDIRECT_URI=http://localhost:5173/api/v1/auth/discord/callback
JWT_SECRET_CURRENT=replace_with_long_random_secret
# Backward compatible alias if JWT_SECRET_CURRENT is unset:
JWT_SECRET=
JWT_ISSUER=vtt-maps-site
JWT_AUDIENCE=vtt-maps-web
OAUTH_STATE_SECRET=replace_with_another_long_random_secret
SUPER_ADMIN_DISCORD_ID=140642000969007104

GITHUB_URL=https://github.com/mbround18/vtt-maps
GITHUB_TOKEN=replace_with_a_github_pat
GITHUB_BRANCH=main

RUSTFS_ENDPOINT=http://localhost:9010
RUSTFS_BUCKET=vtt-maps
RUSTFS_ACCESS_KEY=replace_with_rustfs_access_key
RUSTFS_SECRET_KEY=replace_with_rustfs_secret_key

# optional
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
KOFI_URL=https://ko-fi.com/mbround18
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://localhost:5173
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=168
PORT=8080

# Example generation:
# openssl rand -base64 48
